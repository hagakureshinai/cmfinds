---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/home.css';

const articles = await getCollection('articles', ({ data }) => !data.draft);
---

<BaseLayout title="月と星と空と">
  <section class="home-shell home-editorial">
    <h1>月と星と空と</h1>
    <p class="home-intro">月と星と空が好きな大人のための小さなセレクトメディア</p>

    <div class="article-list">
      {articles.map((article, index) => (
        <article class="article-card">
          <span class="selection-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
          <div class="article-copy">
            <h2><a href={`/articles/${article.id}/`}>{article.data.title}</a></h2>
            <p>{article.data.description}</p>
            <a class="article-read-link" href={`/articles/${article.id}/`} aria-label={`記事を読む：${article.data.title}`}>
              記事を読む<span aria-hidden="true">→</span>
            </a>
          </div>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
